{
  "name": "@kazuya.oda/google-ads-mcp",
  "version": "1.1.0",
  "description": "google-keyword-planner: local MCP server for Google Ads keyword research with user-owned Google Cloud OAuth.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-ads-mcp": "./dist/index.js",
    "google-keyword-planner": "./dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE",
    "SETUP_GUIDE.md",
    "USAGE_EXAMPLES.md",
    "CLOUD_AUTH_SETUP.md",
    "CHANGELOG.md",
    "setup-auth.md",
    "MCP_CONFIG_EXAMPLES.md",
    "SECURITY.md",
    "WINDOWS_SETUP.md",
    "DOCKER_SETUP.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleAdsMcpOrg/google-ads-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/GoogleAdsMcpOrg/google-ads-mcp/issues"
  },
  "homepage": "https://github.com/GoogleAdsMcpOrg/google-ads-mcp#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "prepare": "npm run build",
    "get-refresh-token": "node scripts/get-refresh-token.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "google-ads",
    "keyword-planner",
    "claude",
    "cross-platform"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "google-ads-api": "^25.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
