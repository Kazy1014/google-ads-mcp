# Google Ads API Configuration
# Get these credentials from: https://console.cloud.google.com/

# OAuth2 Client ID
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OAuth2 Client Secret
GOOGLE_ADS_CLIENT_SECRET=your-client-secret

# Legacy Developer Token (optional; ignored by API v25)
# GOOGLE_ADS_DEVELOPER_TOKEN=your-legacy-token

# Refresh Token (obtained through OAuth2 flow)
# Obtain via OAuth Playground using your own OAuth client credentials
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token

# Customer ID (10-digit account number without dashes)
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Login Customer ID (optional, for MCC accounts)
# Required when accessing client accounts under an MCC
# Use the MCC account ID here
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876543210
